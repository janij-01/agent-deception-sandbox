# Adaption is used when this key is set. Get it from Settings, API keys.
ADAPTION_API_KEY=
ADAPTION_MODEL=qwen3.8-27b

# OpenAI, or any OpenAI-compatible server. Used only when ADAPTION_API_KEY is empty.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# OpenRouter example:
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=openai/gpt-4o-mini
